# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Binary assets - track with LFS if added
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.woff filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.eot filter=lfs diff=lfs merge=lfs -text

# Lock specific binary files that change frequently
public/Full Logo Green.png -text
public/Profile Picture Green.jpg -text
public/Profile Picture White.jpg -text
public/step-logo.jpeg -text

# Build-critical images - must not use LFS (Turbopack/Next.js reads at build time)
src/app/icon.png -filter -diff -merge -text
src/app/apple-icon.png -filter -diff -merge -text

# Runtime-fetched public assets - must not use LFS (fetched via public URL by
# PDF export code; deploy target served the raw LFS pointer text instead of
# the smudged binary, breaking pdfmake image embedding in production)
public/qr-code.jpeg -filter -diff -merge -text
public/Profile_Picture_White.png -filter -diff -merge -text
