  reservations                     reservations?               @relation(fields: [reservation_id], references: [id], onUpdate: NoAction)
  users_invoices_updated_byTousers users?                      @relation("invoices_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_invoices_voided_byTousers  users?                      @relation("invoices_voided_byTousers", fields: [voided_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments                         payments[]

  @@index([payment_method], map: "idx_invoices_payment_method")
  @@index([reservation_id], map: "idx_invoices_reservation_id", where: raw("(reservation_id IS NOT NULL)"))
  @@index([contact_id])
  @@index([deleted_at])
  @@index([due_date])
  @@index([issue_date(sort: Desc)])
