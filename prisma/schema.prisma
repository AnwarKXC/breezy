  @@index([action, created_at(sort: Desc), id(sort: Desc)])
  @@index([created_at(sort: Desc), id(sort: Desc)])
  @@index([module, created_at(sort: Desc), id(sort: Desc)])
  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created_at_desc")
  @@index([module, action], map: "idx_audit_logs_module_action")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
