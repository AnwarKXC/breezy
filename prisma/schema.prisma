generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes", "relationJoins", "typedSql"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model accounting_accounts {
  code             String @id
  name_en          String
  name_ar          String
  type             String
  parent_code      String?
  postable         Boolean @default(true)
  requires_contact Boolean @default(false)
  active           Boolean @default(true)
  parent           accounting_accounts? @relation("account_tree", fields: [parent_code], references: [code], onDelete: Restrict, onUpdate: NoAction)
  children         accounting_accounts[] @relation("account_tree")
  lines            accounting_journal_lines[]
  revaluations     accounting_revaluations[]
}

model accounting_periods {
  month      String @id
  status     String @default("open")
  updated_by String? @db.Uuid
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  actor      users? @relation(fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model accounting_journal_entries {
  kind           String @default("manual")
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entry_number   String @unique
  date           DateTime @db.Date
  currency       String
  exchange_rate  Decimal? @db.Decimal(18, 8)
  exchange_rate_date DateTime? @db.Date
  exchange_rate_source String?
  description    String
  created_by     String @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  reversal_of_id String? @unique @db.Uuid
  reversal_of    accounting_journal_entries? @relation("journal_reversal", fields: [reversal_of_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversed_by    accounting_journal_entries? @relation("journal_reversal")
  lines          accounting_journal_lines[]
  actor          users @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  revaluation    accounting_revaluations?
  @@index([currency, date])
}

model accounting_revaluations {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entry_id       String @unique @db.Uuid
  date           DateTime @db.Date
  currency       String
  account_code   String
  contact_id     String? @db.Uuid
  closing_rate   Decimal @db.Decimal(18, 8)
  source         String
  native_balance Decimal @db.Decimal(30, 2)
  base_before    Decimal @db.Decimal(30, 2)
  base_after     Decimal @db.Decimal(30, 2)
  delta          Decimal @db.Decimal(30, 2)
  created_by     String @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  entry          accounting_journal_entries @relation(fields: [entry_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  account        accounting_accounts @relation(fields: [account_code], references: [code], onDelete: Restrict, onUpdate: NoAction)
  contact        contacts? @relation(fields: [contact_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actor          users @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([currency, account_code, date])
}

model accounting_journal_lines {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entry_id     String @db.Uuid
  account_code String
  contact_id   String? @db.Uuid
  debit        Decimal @default(0) @db.Decimal(12, 2)
  credit       Decimal @default(0) @db.Decimal(12, 2)
  base_debit   Decimal? @db.Decimal(24, 2)
  base_credit  Decimal? @db.Decimal(24, 2)
  description  String @default("")
  sort_order   Int @default(0)
  entry        accounting_journal_entries @relation(fields: [entry_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  account      accounting_accounts @relation(fields: [account_code], references: [code], onDelete: Restrict, onUpdate: NoAction)
  contact      contacts? @relation(fields: [contact_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([entry_id])
  @@index([account_code, entry_id])
  @@index([contact_id])
}

model accounting_ledger_entries {
  id                              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_number              String                      @unique
  type                            String
  source_type                     String
  source_id                       String?                     @db.Uuid
  income_amount                   Decimal                     @default(0) @db.Decimal(12, 2)
  outcome_amount                  Decimal                     @default(0) @db.Decimal(12, 2)
  currency                        String                      @default("EGP")
  account_category                String?
  description                     String                      @default("")
  transaction_date                DateTime                    @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_by                      String?                     @db.Uuid
  metadata                        Json?                       @default("{}")
  reversal_of_transaction_id      String?                     @db.Uuid
  created_at                      DateTime                    @default(now()) @db.Timestamptz(6)
  invoice_id                      String?                     @db.Uuid
  contact_id                      String?                     @db.Uuid
  contacts                        contacts?                   @relation(fields: [contact_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                           users?                      @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices                        invoices?                   @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  accounting_ledger_entries       accounting_ledger_entries?  @relation("accounting_ledger_entriesToaccounting_ledger_entries", fields: [reversal_of_transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_accounting_ledger_entries accounting_ledger_entries[] @relation("accounting_ledger_entriesToaccounting_ledger_entries")

  @@index([contact_id])
  @@index([invoice_id])
  @@index([reversal_of_transaction_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model accounting_settings {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  value       Json     @default("{}")
  description String?
  updated_by  String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// Deployment-wide app configuration (theme, branding, ...). Missing row = built-in default.
/// AI data assistant audit trail + daily token budget source. One row per chat turn.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_chat_turns {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  conversation_id String   @db.Uuid
  question        String
  answer          String   @default("")
  tool_calls      Json     @default("[]")
  blocks          Json     @default("[]")
  provider        String
  model           String
  input_tokens    Int      @default(0)
  output_tokens   Int      @default(0)
  status          String
  error_code      String?
  latency_ms      Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  users           users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "ai_chat_turns_user_created_idx")
  @@index([conversation_id, created_at], map: "ai_chat_turns_conversation_idx")
}

model app_settings {
  key        String   @id
  value      Json     @default("{}")
  updated_by String?  @db.Uuid
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  users      users?   @relation(fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
