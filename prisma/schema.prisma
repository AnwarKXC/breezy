  voided_by                        String?                     @db.Uuid
  guest_name                       String?
  company_name                     String?
  public_notes                     String?
  internal_notes                   String?
  issued_at                        DateTime?                   @db.Timestamptz(6)
  issued_by                        String?                     @db.Uuid
  refunded_amount                  Decimal                     @default(0) @db.Decimal(10, 2)
  currency                         String                      @default("EGP")
