  remaining_balance                Decimal                     @default(0) @db.Decimal(10, 2)
  stay_check_in                    DateTime?                   @db.Date
  stay_check_out                   DateTime?                   @db.Date
  created_by                       String?                     @db.Uuid
  updated_by                       String?                     @db.Uuid
  void_reason                      String?
