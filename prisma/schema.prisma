model contacts {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                      contact_type
  name                      String
  phone                     String?                     @unique(map: "contacts_phone_unique_idx", where: raw("((deleted_at IS NULL) AND (phone IS NOT NULL) AND (phone <> ''::text))"))
  email                     String?
  logo                      String?
  country                   String?                     @db.VarChar(2)
  city                      String?
  responsible_person        String?
  id_passport               String?
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  deleted_at                DateTime?                   @db.Timestamptz(6)
  accounting_ledger_entries accounting_ledger_entries[]
  accounting_journal_lines  accounting_journal_lines[]
  accounting_revaluations   accounting_revaluations[]
  company_price_overrides   company_price_overrides[]
  invoices                  invoices[]
  reservation_company_info  reservation_company_info[]
  reservation_guests        reservation_guests[]
  reservations              reservations[]

  @@index([country, city])
  @@index([created_at(sort: Desc), id(sort: Desc)])
  @@index([deleted_at])
  @@index([type, created_at(sort: Desc), id(sort: Desc)])
}

