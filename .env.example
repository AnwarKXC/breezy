# Postgres (Neon). Use the pooled connection string (host contains "-pooler").
# Migrations derive the direct URL from it automatically (see prisma.config.ts).
DATABASE_URL="postgresql://<user>:<password>@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Optional: only when the direct URL cannot be derived from DATABASE_URL.
# DIRECT_URL=""

# Optional
ALLOWED_ORIGINS=""

# First admin account (pnpm admin:create)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Admin "forgot password" emails (Resend). Without these, dev prints the link to the server console.
APP_URL=""
RESEND_API_KEY=""
EMAIL_FROM=""

# Hotel mailbox (Settings > Email). Encrypts the stored IMAP/SMTP password; 32+ random chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it later means re-entering the mailbox password in Settings.
EMAIL_ENCRYPTION_KEY=""

# AI data assistant (/assistant, admin only). Gemini Developer API key from aistudio.google.com.
CHATBOT_KEY=""
# Gemini model id; switch to a newer Flash-Lite here without code changes.
CHATBOT_MODEL="gemini-3.5-flash-lite"
# Optional: model used for the rest of a turn when the primary model errors or is unavailable.
CHATBOT_MODEL_CALLBACK=""
# free | paid. Google may use free-tier prompts (which contain hotel data) to improve its
# products, so the free tier never runs in production. In development it runs on
# localhost, or elsewhere (e.g. LAN IP) when AI_SEEDED_DATA_ONLY="true" (fake/demo data only).
AI_GEMINI_TIER="free"
AI_SEEDED_DATA_ONLY="false"
# Tokens (input + output) each admin may use per day.
AI_DAILY_TOKEN_LIMIT="300000"

# Fleet management (control plane). Leave FLEET_LICENSE_PUBLIC_KEY empty for an
# unmanaged install (dev/demo): no license checks. See docs/fleet.md.
# This instance's id in the control plane; must match the license `sub`.
FLEET_INSTANCE_ID=""
# Bearer secret the control plane uses for /api/system/*; 32+ random chars, unique per hotel.
FLEET_INSTANCE_SECRET=""
# Control plane's Ed25519 public key (pnpm fleet:license keygen). Literal 
 allowed.
FLEET_LICENSE_PUBLIC_KEY=""
# Initial license for a fresh install; later renewals are pushed by the control plane.
FLEET_LICENSE_KEY=""
# Release version reported to the control plane (set by CI: git tag or sha).
APP_VERSION=""
