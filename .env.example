# Supabase is used only as a Postgres host.
# Runtime queries (Prisma) - transaction pooler, port 6543
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations (prisma migrate deploy) - session pooler, port 5432
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Optional
ALLOWED_ORIGINS=""

# First admin account (pnpm admin:create)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Admin "forgot password" emails (Resend). Without these, dev prints the link to the server console.
APP_URL=""
RESEND_API_KEY=""
EMAIL_FROM=""

# Hotel mailbox (Settings > Email). Encrypts the stored IMAP/SMTP password; 32+ random chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it later means re-entering the mailbox password in Settings.
EMAIL_ENCRYPTION_KEY=""

# AI data assistant (/assistant, admin only). Gemini Developer API key from aistudio.google.com.
CHATBOT_KEY=""
# Gemini model id; switch to a newer Flash-Lite here without code changes.
CHATBOT_MODEL="gemini-3.5-flash-lite"
# Optional: model used for the rest of a turn when the primary model errors or is unavailable.
CHATBOT_MODEL_CALLBACK=""
# free | paid. Google may use free-tier prompts (which contain hotel data) to improve its
# products, so the free tier never runs in production. In development it runs on
# localhost, or elsewhere (e.g. LAN IP) when AI_SEEDED_DATA_ONLY="true" (fake/demo data only).
AI_GEMINI_TIER="free"
AI_SEEDED_DATA_ONLY="false"
# Tokens (input + output) each admin may use per day.
AI_DAILY_TOKEN_LIMIT="300000"
